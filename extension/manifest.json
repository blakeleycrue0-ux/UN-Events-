{
  "manifest_version": 3,
  "name": "Jarvis para Chromebook",
  "version": "1.2.0",
  "description": "Deja que Jarvis haga cosas en este Chromebook: música, webs y tareas de varios pasos (Teams, Gmail, descargas) con tu confirmación.",
  "permissions": ["storage", "tabs", "scripting", "alarms", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Jarvis", "default_popup": "options.html" },
  "options_page": "options.html",
  "content_scripts": [
    { "matches": ["https://www.youtube.com/results*", "https://open.spotify.com/search/*"], "js": ["autoplay.js"], "run_at": "document_idle" },
    { "matches": ["https://unevents.netlify.app/*", "http://127.0.0.1:8001/*"], "js": ["bridge.js"], "run_at": "document_start" }
  ]
}
